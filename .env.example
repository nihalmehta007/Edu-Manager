# MongoDB Connection URI
# Local MongoDB (default for development):
MONGO_URI=mongodb://localhost:27017/edumanage

# MongoDB Atlas (for production):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/edumanage?retryWrites=true&w=majority

# Flask Secret Key for session signing & CSRF protection
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars
